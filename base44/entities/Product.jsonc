{
  "name": "Product",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string",
      "description": "Reference to Artist"
    },
    "artist_name": {
      "type": "string",
      "description": "Denormalized artist name for display"
    },
    "artist_slug": {
      "type": "string",
      "description": "Denormalized artist slug for URLs"
    },
    "title": {
      "type": "string",
      "description": "Product title",
      "index": true
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album"
      ],
      "default": "single",
      "description": "Product type"
    },
    "genre": {
      "type": "string",
      "description": "Music genre",
      "index": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional tags for discovery"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price_cents": {
      "type": "number",
      "description": "Price in cents"
    },
    "archive_price_cents": {
      "type": "number",
      "description": "Higher price after drop window ends"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code"
    },
    "cover_url": {
      "type": "string",
      "description": "Cover art URL"
    },
    "audio_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of full audio file URLs"
    },
    "preview_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of 30-60s preview audio URLs"
    },
    "track_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of track names corresponding to audio_urls"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "live"
      ],
      "default": "draft",
      "description": "Publication status",
      "index": true
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Release date"
    },
    "total_sales": {
      "type": "number",
      "default": 0,
      "description": "Total number of sales"
    },
    "total_revenue_cents": {
      "type": "number",
      "default": 0,
      "description": "Total revenue in cents"
    },
    "edition_type": {
      "type": "string",
      "enum": [
        "unlimited",
        "limited"
      ],
      "default": "unlimited",
      "description": "Edition type - unlimited or limited"
    },
    "edition_limit": {
      "type": "number",
      "description": "Maximum number of copies (for limited editions)"
    },
    "edition_name": {
      "type": "string",
      "description": "Name of the edition (e.g., First Press, Signed)"
    },
    "drop_window_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a timed release"
    },
    "drop_window_end": {
      "type": "string",
      "format": "date-time",
      "description": "When the drop window closes"
    },
    "bundle_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether bundle is enabled"
    },
    "bundle_product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product IDs included in bundle"
    },
    "bundle_discount_percent": {
      "type": "number",
      "description": "Discount percentage for bundle"
    },
    "edit_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "editor": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Version history of product edits"
    }
  },
  "required": [
    "artist_id",
    "title",
    "price_cents",
    "cover_url"
  ],
  "rls": {
    "create": {
      "data.artist_id": "{{user.data.artist_profile_id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "live"
        },
        {
          "data.artist_id": "{{user.data.artist_profile_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.artist_id": "{{user.data.artist_profile_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.artist_id": "{{user.data.artist_profile_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}