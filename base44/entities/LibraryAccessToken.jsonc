{
  "name": "LibraryAccessToken",
  "type": "object",
  "properties": {
    "buyer_email": {
      "type": "string",
      "description": "Email address this token belongs to"
    },
    "token": {
      "type": "string",
      "description": "Unique access token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Token expiration timestamp"
    },
    "used": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "buyer_email",
    "token",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.buyer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}